{
  "name": "rasoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/app.ts",
    "dev:web": "vite",
    "dev:webhook-proxy": "tsx scripts/webhook-proxy.ts",
    "build": "pnpm build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/src/server/app.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "eval:intents": "tsx --env-file-if-exists=.env scripts/eval-intents.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@react-three/fiber": "9.3.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
